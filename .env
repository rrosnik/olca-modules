NBLA_MONGO_PASSWORD=password

NBLA_MONGO_STORAGE_PATH=./mongodb/db
NBLA_MONGO_LOG_PATH=./mongodb/mongo.log
NBLA_MONGO_CONF_PATH=./mongodb/mongod.conf

#####################################################################
# JWT
#####################################################################
