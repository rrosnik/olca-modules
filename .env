DOMAIN=nbla.ca


# 100 MB = 104857600 bytes = 100 * 1024 * 1024
NBLA_FILE_SIZE_LIMITS_IFC=104857600

#####################################################################
# AUTH SERVICE
#####################################################################
NBLA_AUTH_INSTANCE_NAME=auth-service-1
NBLA_AUTH_SERVICE_NAME=auth.nbla.ca
NBLA_AUTH_SERVICE_PORT=4000
NBLA_AUTH_MONGO_DBNAME=auth

NBLA_AUTH_AS_ISSUER=https://auth.nbla.ca/oidc/v1
NBLA_AUTH_AS_AUTHORIZATION_ENDPOINT=https://auth.nbla.ca/oidc/v1/authorize
NBLA_AUTH_AS_TOKEN_ENDPOINT=https://auth.nbla.ca/oidc/v1/token
NBLA_AUTH_AS_USERINFO_ENDPOINT=https://auth.nbla.ca/oidc/v1/userinfo
NBLA_AUTH_AS_REVOCATION_ENDPOINT=https://auth.nbla.ca/oidc/v1/revoke
# NBLA_AUTH_AS_JWKS_URI=https://kms.nbla.ca/jwks
NBLA_AUTH_AS_JWKS_URI=http://kms.nbla.ca:4002/jwks

#####################################################################
# Web Service (app)
#####################################################################
NBLA_WEB_SERVICE_NAME=app.nbla.ca
NBLA_WEB_SERVICE_PORT=8888


#####################################################################
# Key Management Service(KMS)
#####################################################################
NBLA_KMS_SERVICE_NAME=kms.nbla.ca
NBLA_KMS_SERVICE_PORT=4002
NBLA_KMS_GRPC_PORT=9402
NBLA_KMS_MONGO_DBNAME=kms

#####################################################################
# STORAGE SERVICE
#####################################################################
NBLA_STORAGE_SERVICE_NAME=storage.nbla.ca
NBLA_STORAGE_SERVICE_PORT=4001
NBLA_STORAGE_GRPC_PORT=9401
NBLA_STORAGE_MONGO_DBNAME=storage
NBLA_STORAGE_BASE_DIR=./root/fileStorage

#####################################################################
# Messaging Service
#####################################################################
NBLA_MESSAGE_CONTAINER_NAME=nbla-container-messaging
NBLA_MESSAGE_CONTAINER_PORT=4444
NBLA_MESSAGE_SERVICE_NAME=localhost
NBLA_MESSAGE_SERVICE_PORT=4444
NBLA_MESSAGE_GRPC_SERVER_PORT=4444


#####################################################################
# API Gateway (NGINX)
#####################################################################
API_GATEWAY_CONTAINER_NAME=nbla-container-gateway
API_GATEWAY_CONTAINER_PORT=80
API_GATEWAY_CONTAINER_PORT_SSL=443

API_GATEWAY_SERVICE_NAME=localhost
API_GATEWAY_SERVICE_PORT=80



#####################################################################
# MAPPER SERVICE
#####################################################################
NBLA_MAPPER_CONTAINER_NAME=nbla-container-mapper
NBLA_MAPPER_CONTAINER_PORT=4008

NBLA_MAPPER_SERVICE_NAME=nbla-container-mapper
NBLA_MAPPER_SERVICE_PORT=4008

NBLA_MAPPER_DB_NAME=mapper

#####################################################################
# MODIFIER SERVICE
#####################################################################
MODIFIER_SERVICE_URL=localhost:4009
MODIFIER_SERVICE_URL_SCHEMA=http
MODIFIER_SERVICE_INTERNAL_PORT=4009
MODIFIER_SERVICE_EXPOSED_PORT=4009
MODIFIER_SERVICE_CONTAINER_NAME=nbla-modifier-service

#####################################################################
# LOG Service
#####################################################################
LOG_SERVICE_CONTAINER_NAME=nbla-log-service
LOG_SERVICE_INTERNAL_PORT=4444
LOG_SERVICE_EXPOSED_PORT=4444

#####################################################################
# Main Service
#####################################################################
NBLA_MAIN_SERVICE_NAME=main.nbla.ca
NBLA_MAIN_SERVICE_PORT=4005
NBLA_MAIN_MONGO_DBNAME=main
NBLA_MAIN_TEMP_DIR=./tmp
# 100 MB = 104857600 bytes = 100 * 1024 * 1024
NBLA_FILE_SIZE_LIMITS_IFC=524288000

#####################################################################
# IDS Service
#####################################################################
IDS_SERVICE_CONTAINER_NAME=nbla-ids-service
IDS_SERVICE_INTERNAL_PORT=4004
IDS_SERVICE_EXPOSED_PORT=4004
IDS_SERVICE_MONGO_DB_NAME=ids
IDS_SERVICE_USERNAME=nbla-ids-service
IDS_SERVICE_EMAIL=ids@nbla.app
IDS_SERVICE_PASSWORD="pasword"

#####################################################################
# IFC Service
#####################################################################
NBLA_IFC_IMAGE_NAME=nbla-ifc

NBLA_IFC_CONTAINER_NAME=nbla-container-ifc
NBLA_IFC_CONTAINER_PORT=4030

NBLA_IFC_SERVICE_NAME=localhost
NBLA_IFC_SERVICE_PORT=4030

#####################################################################
# LCA Service
#####################################################################
NBLA_LCA_SERVICE_NAME=lca.nbla.ca
NBLA_LCA_SERVICE_PORT=4022

NBLA_LCA_SERVICE_DATA_DIR="/app/dbDir"
NBLA_LCA_SERVICE_DB_NAME="ecoinvent"
#####################################################################
# RabbitMQ
#####################################################################
NBLA_RABBITMQ_CONTAINER_NAME=nbla-container-message-broker
NBLA_RABBITMQ_CONTAINER_PORT=5672

NBLA_RABBITMQ_SERVICE_NAME=localhost
NBLA_RABBITMQ_SERVICE_PORT=5672

NBLA_RABBITMQ_USERNAME=user
NBLA_RABBITMQ_PASSWORD=password

NBLA_RABBITMQ_DEFAULT_USERNAME=user
NBLA_RABBITMQ_DEFAULT_PASSWORD=password
NBLA_RABBITMQ_DEFAULT_VHOST=_test

#####################################################################
# Cache Service
#####################################################################
NBLA_CACHE_CONTAINER_NAME=nbla-container-cache
NBLA_CACHE_CONTAINER_PORT=6379

NBLA_CACHE_SERVICE_NAME=cache.nbla.ca
NBLA_CACHE_SERVICE_PORT=6379

NBLA_CACHE_USERNAME=user
NBLA_CACHE_PASSWORD=password

#####################################################################
# MongoDB
#####################################################################
NBLA_MONGO_SERVICE_NAME=mongodb.db.nbla.ca
NBLA_MONGO_SERVICE_PORT=27017
